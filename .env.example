# Postgres connection string — used in EVERY environment (SQLite's native driver
# can't run on serverless hosts like Vercel, so the app is Postgres-only).
#
# Local dev — run Postgres in Docker:
#   docker run -d --name codebox-pg -e POSTGRES_PASSWORD=codebox -e POSTGRES_DB=codebox -p 5432:5432 postgres:16
# then use:
DATABASE_URI=postgres://postgres:codebox@localhost:5432/codebox
#
# (You can also point local dev at a hosted Neon database instead.)
# On Vercel: set DATABASE_URI to your Neon POOLED connection string, or let the
# Neon integration inject DATABASE_URL / POSTGRES_URL.

# Long random string used to sign auth tokens. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=YOUR_SECRET_HERE
