# Database connection.
# Local dev (zero-config): a SQLite file.
DATABASE_URI=file:./codebox.db
# Production / serverless (Vercel): a hosted Postgres connection string, e.g. Neon.
#   The adapter is chosen automatically from the URL scheme (postgres:// -> Postgres).
#   On Vercel you can instead let the Neon integration inject DATABASE_URL / POSTGRES_URL.
# DATABASE_URI=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# Long random string used to sign auth tokens. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=YOUR_SECRET_HERE
